<?xml version="1.0" encoding="utf-8"?>
<!-- Configuracion compartida por todas las practicas.
     Las rutas son relativas a ESTA carpeta, asi funciona en cualquier computadora. -->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <LibsDir>$(MSBuildThisFileDirectory)External Libraries\</LibsDir>
  </PropertyGroup>
  <PropertyGroup>
    <OutDir>$(ProjectDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)obj\$(Configuration)\</IntDir>
    <LocalDebuggerWorkingDirectory>$(ProjectDir)</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(LibsDir)GLEW\include;$(LibsDir)GLFW\include;$(LibsDir)glm;$(LibsDir)assimp\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(LibsDir)GLEW\lib\Release\Win32;$(LibsDir)GLFW\lib-vc2015;$(LibsDir)assimp\lib;$(LibsDir)SOIL2\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>opengl32.lib;glew32.lib;glfw3.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>xcopy /y /d /q "$(LibsDir)GLEW\bin\Release\Win32\glew32.dll" "$(OutDir)" &gt; nul</Command>
      <Message>Copiando DLLs junto al ejecutable</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
</Project>
